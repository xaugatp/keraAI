# --- app ---
APP_ENV=development            # development | production | test
APP_NAME=KeraAI API
API_V1_PREFIX=/api/v1
ENABLE_DOCS=true               # false in production
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000"]   # add https://app.<domain> in prod
TRUST_CLOUDFLARE_HEADERS=false           # true when behind the tunnel
SIGNING_SECRET=change-me-to-a-random-32-plus-character-secret
SIGNED_URL_TTL_SECONDS=3600

# --- database ---
# This machine's SQL Server instance only has Windows Authentication enabled
# (Mixed Mode is off) and TCP/IP is currently disabled for the default
# instance — DB_TRUSTED_CONNECTION=true (Windows auth) is the only option
# that works without extra setup in SSMS / SQL Server Configuration Manager.
DB_HOST=localhost              # or localhost\SQLEXPRESS
DB_PORT=                       # optional
DB_NAME=KeraAI
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=true     # true = Windows auth (then user/password ignored)
DB_USER=kera_app
DB_PASSWORD=
DB_TRUST_SERVER_CERT=true      # local dev self-signed cert
DB_POOL_SIZE=5
DB_ECHO=false

# --- storage & uploads ---
# No D: drive on this machine — DATA_ROOT lives on C: instead.
DATA_ROOT=C:/kera-data
MAX_UPLOAD_MB=10
MIN_IMAGE_SIDE_PX=64
MAX_IMAGE_PIXELS=40000000      # decompression-bomb guard
STORE_MAX_SIDE_PX=2048         # downscale stored original
THUMBNAIL_SIDE_PX=320
ALLOWED_IMAGE_FORMATS=["JPEG","PNG","WEBP"]

# --- inference ---
INFERENCE_DEVICE=auto          # auto | cpu | cuda:0 (this machine: Intel Arc iGPU, no CUDA -> resolves to cpu)
RATE_LIMIT_PREDICT=10/minute
RATE_LIMIT_DEFAULT=120/minute

# --- model 1: tree classification ---
TREE_ENABLED=true
TREE_WEIGHTS_PATH=weights/tree_cls_v1.pt
TREE_MODEL_VERSION=tree_cls_v1
TREE_IMGSZ=224
TREE_POSITIVE_CLASS=banana_tree          # must exist in model.names
TREE_UNCERTAIN_THRESHOLD=0.60
TREE_DISPLAY_NAMES={"banana_tree":"Banana tree","non_banana":"Not a banana tree"}
