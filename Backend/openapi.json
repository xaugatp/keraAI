  "info": {
    "title": "KeraAI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/analyses": {
      "get": {
        "operationId": "list_analyses_api_v1_analyses_get",
        "parameters": [
          {
            "description": "Only this model",
            "in": "query",
            "name": "model_key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "tree_classification",
                    "leaf_segmentation",
                    "leaf_disease"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this model",
              "title": "Model Key"
            }
          },
          {
            "description": "mine = your own, samples = public samples, all_visible = both",
            "in": "query",
            "name": "scope",
            "required": false,
            "schema": {
              "default": "all_visible",
              "description": "mine = your own, samples = public samples, all_visible = both",
              "enum": [
                "mine",
                "samples",
                "all_visible"
              ],
              "title": "Scope",
              "type": "string"
            }
          },
          {
            "description": "1-based page number",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "1-based page number",
              "maximum": 1000000,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
