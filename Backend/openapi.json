          },
          "is_uncertain": {
            "title": "Is Uncertain",
            "type": "boolean"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "model_key": {
            "enum": [
              "tree_classification",
