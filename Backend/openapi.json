      "GeoLocation": {
        "description": "Where and when the photo was taken, as reported by the client's device.\n\nEvery field is optional because the client may send any subset; the whole\nblock is ``null`` on an analysis when it sent none of them.",
        "properties": {
          "accuracy_m": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "GPS accuracy in metres",
            "title": "Accuracy M"
          },
          "captured_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Client-reported capture time (UTC)",
            "title": "Captured At"
          },
          "latitude": {
            "anyOf": [
              {
