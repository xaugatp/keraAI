            ],
            "description": "ISO-8601 capture time; a time without an offset is read as UTC",
            "title": "Captured At"
          },
          "gps_accuracy_m": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "GPS accuracy in metres",
            "title": "Gps Accuracy M"
          },
          "image": {
            "contentMediaType": "application/octet-stream",
            "description": "Photo to analyse (JPEG, PNG or WEBP)",
            "title": "Image",
            "type": "string"
          },
          "latitude": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Degrees, -90..90",
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Degrees, -180..180",
            "title": "Longitude"
          },
          "source": {
            "default": "upload",
            "description": "Where the photo came from",
            "enum": [
              "upload",
              "camera"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "image"
        ],
        "title": "Body_predict_leaf_segmentation_api_v1_leaf_segmentation_predict_post",
        "type": "object"
      },
