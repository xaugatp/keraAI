{
  "components": {
    "schemas": {
      "AnalysisDetail": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "details": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "leaf_segmentation": "#/components/schemas/LeafSegDetails",
                    "tree_classification": "#/components/schemas/TreeDetails"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/TreeDetails"
                  },
                  {
                    "$ref": "#/components/schemas/LeafSegDetails"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/ImageLinks"
          },
          "is_sample": {
            "title": "Is Sample",
            "type": "boolean"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoLocation"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when the client sent no coordinates, accuracy or capture time"
          },
          "model_key": {
            "enum": [
              "tree_classification",
              "leaf_segmentation",
              "leaf_disease"
            ],
            "title": "Model Key",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "prediction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Prediction"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "enum": [
              "upload",
              "camera",
              "sample"
            ],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "timings_ms": {
            "$ref": "#/components/schemas/TimingsMs"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "id",
          "model_key",
          "model_version",
          "status",
          "source",
          "is_sample",
          "prediction",
          "details",
          "location",
          "image",
          "timings_ms",
          "created_at"
        ],
        "title": "AnalysisDetail",
        "type": "object"
      },
