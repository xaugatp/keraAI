        ],
        "title": "AnalysisSummary",
        "type": "object"
      },
      "Body_predict_leaf_segmentation_api_v1_leaf_segmentation_predict_post": {
        "properties": {
          "captured_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
