      "LeafSegDetails": {
        "properties": {
          "affected_area_pct_of_leaf": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Affected Area Pct Of Leaf",
            "type": "number"
          },
          "kind": {
            "const": "leaf_segmentation",
            "title": "Kind",
            "type": "string"
          },
          "largest_lesion_pct_of_leaf": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Largest Lesion Pct Of Leaf",
            "type": "number"
          },
          "leaf_area_pct_of_image": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Leaf Area Pct Of Image",
            "type": "number"
          },
          "lesion_count": {
            "minimum": 0.0,
            "title": "Lesion Count",
            "type": "integer"
          },
          "mean_affected_probability": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Affected Probability"
          },
          "mean_leaf_probability": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Leaf Probability"
          },
          "thresholds": {
            "$ref": "#/components/schemas/LeafSegThresholds"
          }
        },
        "required": [
          "kind",
          "leaf_area_pct_of_image",
          "affected_area_pct_of_leaf",
          "lesion_count",
          "largest_lesion_pct_of_leaf",
          "thresholds"
        ],
        "title": "LeafSegDetails",
        "type": "object"
      },
      "LeafSegThresholds": {
        "description": "The exact policy that produced a result, echoed so a stored row is reproducible.",
        "properties": {
          "affected": {
            "description": "p(affected) >= this -> affected pixel",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Affected",
            "type": "number"
          },
          "leaf": {
            "description": "p(leaf) >= this -> leaf pixel",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Leaf",
            "type": "number"
          },
          "min_affected_pct": {
            "description": "affected share of the leaf (%) below which the leaf is 'healthy'",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Min Affected Pct",
            "type": "number"
          },
          "min_leaf_pct": {
            "description": "leaf share of the image (%) below which the result is 'no_leaf'",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Min Leaf Pct",
            "type": "number"
          },
          "min_lesion_pct": {
            "description": "lesion blobs smaller than this % of the leaf area are dropped",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Min Lesion Pct",
            "type": "number"
          },
          "tta_hflip": {
            "description": "probabilities averaged with the horizontally flipped pass",
            "title": "Tta Hflip",
            "type": "boolean"
          }
        },
        "required": [
          "leaf",
          "affected",
          "min_leaf_pct",
          "min_lesion_pct",
          "min_affected_pct",
          "tta_hflip"
        ],
        "title": "LeafSegThresholds",
        "type": "object"
      },
      "ModelInfoOut": {
