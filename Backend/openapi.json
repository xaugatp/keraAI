            ],
            "title": "Model Key",
            "type": "string"
          },
          "source": {
            "enum": [
              "upload",
              "camera",
              "sample"
            ],
            "title": "Source",
            "type": "string"
          },
          "thumbnail_url": {
            "title": "Thumbnail Url",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
