# Base URL of the KeraAI backend (FastAPI). Copy this file to `.env.local` for local dev.
# This value is PUBLIC: Vite bakes every VITE_* variable into the browser bundle, so never put
# secrets here. On Netlify, set the same variable in Site settings > Environment variables
# (use the Cloudflare Tunnel URL, e.g. https://api.<your-domain>) before building.
VITE_API_BASE_URL=http://127.0.0.1:8000
